# Frontend build-time env for the Vercel deploy (Phase 12.5).
# Real values are set in the Vercel dashboard (Project → Settings → Environment
# Variables, for BOTH Production and Preview scopes) — never committed here.
#
# Point these at the Hugging Face Space backend (Phase 12 backend host):
VITE_API_URL=https://<hf-user>-market-assistant.hf.space
VITE_WS_URL=wss://<hf-user>-market-assistant.hf.space

# Supabase (Phase 11 auth) — public anon key is safe to expose to the browser.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
